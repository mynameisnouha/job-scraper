# Copy this file to .env and fill it in. .env is gitignored — never commit it.
# See the Configuration section of README.md.

# --- Required: Supabase (Project Settings -> API) ---
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Required: one LLM key, for the provider your models use ---
# The default models are Anthropic's.
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=...

# --- Optional: models (defaults in config.py) ---
# Any LiteLLM model name: https://docs.litellm.ai/docs/providers
# LLM_MODEL=anthropic/claude-sonnet-4-6          # full scoring and CV tailoring
# LLM_SCREEN_MODEL=anthropic/claude-haiku-4-5    # cheap screening pass
# ONBOARDING_MODEL=anthropic/claude-haiku-4-5    # the Set up page's one CV read

# Optional: enable debug logging
# LLM_DEBUG=true

# --- Optional: email alert when a run scores a job at or above the threshold ---
# Any SMTP provider works. With Gmail, turn on 2-Step Verification and create an
# App Password (myaccount.google.com/apppasswords) — the account password is
# always refused. Verify with: python -m scoring.notify --test
# EMAIL_ALERTS_ENABLED=true
# EMAIL_ALERT_MIN_SCORE=70
# EMAIL_ALERT_MIN_SCORE_ENGLISH=55   # lower bar for English-language ads; never above the one above
# ROLE_FOCUS_SOFTWARE_CAP=60   # highest score a general software role (no AI/ML/data core) can get
# AUTO_APPLY_ENABLED=false     # auto apply is paused; true brings its buttons back
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com

# Optional: default weekly application goal for the "Applications per week" panel
# on "Where I applied". Overridden by whatever you save under "Customize" there.
# WEEKLY_APPLICATION_GOAL=15

# --- Optional: Auto apply (see the Auto apply section of README.md) ---
# ATS_EMAIL=
# ATS_PASSWORD=
# IMAP_PASSWORD=          # Gmail app password; falls back to SMTP_PASSWORD
# CLAUDE_BIN=             # path to claude.exe if it is not found automatically
# GENERIC_COVER_LETTER_PATH=
