# Required: Supabase configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required: LLM API key (use one of the following)
# For Anthropic Claude:
ANTHROPIC_API_KEY=sk-ant-...
# For Google Gemini:
# GEMINI_API_KEY=your_gemini_api_key
# For OpenAI:
# OPENAI_API_KEY=sk-...
# For Groq:
# GROQ_API_KEY=...

# Optional: override LLM_MODEL from config.py
# LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: enable debug logging
# LLM_DEBUG=true

# Optional: email alert when a run scores a job at or above the threshold.
# Any SMTP provider works. With Gmail, turn on 2-Step Verification and create an
# App Password (myaccount.google.com/apppasswords) — the account password is
# always refused. Verify with: python notify.py --test
# EMAIL_ALERTS_ENABLED=true
# EMAIL_ALERT_MIN_SCORE=70
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com
