# Required: Supabase configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required: LLM API key (use one of the following)
# For Anthropic Claude:
ANTHROPIC_API_KEY=sk-ant-...
# For Google Gemini:
# GEMINI_API_KEY=your_gemini_api_key
# For OpenAI:
# OPENAI_API_KEY=sk-...
# For Groq:
# GROQ_API_KEY=...

# Optional: override LLM_MODEL from config.py
# LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: Email daily digest (Gmail example below)
# For Gmail: use smtp.gmail.com on port 587 with an App Password (not your regular password)
# Generate one at https://myaccount.google.com/apppasswords
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=where_to_receive_digest@example.com

# Optional: enable debug logging
# LLM_DEBUG=true
